@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Native stage timestamps work with GNU and BSD date output."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+s=Path('scripts/build-app.sh').read_text()
+helper=s[s.index('now_ms() {'):s.index('\nrss_cmd()')]
+with tempfile.TemporaryDirectory(prefix='bp-build-clock-') as d:
+    root=Path(d)
+    probe=root/'probe.sh';probe.write_text('#!/bin/sh\nset -eu\n'+helper+'\nnow_ms\n')
+    for bsd in [False,True]:
+        env=dict(os.environ)
+        if bsd:
+            date=root/'date';date.write_text('#!/bin/sh\nprintf "N\\n"\n');date.chmod(0o755)
+            env['PATH']=str(root)+':'+env['PATH']
+        before=int(time.time()*1000)
+        value=int(subprocess.check_output(['sh',str(probe)],env=env,text=True).strip())
+        after=int(time.time()*1000)
+        assert before-20 <= value <= after+20,(value,before,after)
+        print('ok native stage clock with '+('BSD date fallback' if bsd else 'GNU date'))
diff --git a/test/tools/build_lock_test.py b/test/tools/build_lock_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..3cd2f2a63266fd93d491f05af7f94deb7f4bfaf6
--- /dev/null
+++ b/test/tools/build_lock_test.py
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+"""An ancestor mentioning flock is not an ancestor holding flock."""
+import pathlib
+import subprocess
+import tempfile
+
+source = pathlib.Path('scripts/build-app.sh').read_text()
+helper = source[source.index('held() {'):source.index('\nif [ -z "${BP_BUILD_LOCKED')]
+with tempfile.TemporaryDirectory(prefix='bp-build-lock-test-') as tmp:
+    # Exercise the real ancestry parser against a private lock so the
+    # regression never waits for or interferes with an actual native build.
+    lock = str(pathlib.Path(tmp) / 'bp-wt-build.lock')
+    helper = helper.replace('/tmp/bp-wt-build.lock', lock)
+    probe = pathlib.Path(tmp) / 'probe.sh'
+    probe.write_text('#!/bin/sh\n' + helper + '\nif held; then exit 0; else exit 1; fi\n')
+    # Actual shell ancestry, including misleading literal script text.
+    r = subprocess.run(['sh', '-c', 'sh "$1"; result=$?; : "flock $2"; exit "$result"', 'sh', str(probe), lock])
+    assert r.returncode == 1, 'script text falsely claims the native lock'
+    print('ok mention in ancestor script does not bypass native lock')
+    r = subprocess.run(['flock', lock, 'sh', str(probe)])
+    assert r.returncode == 0, 'actual outer flock not recognized'
+    print('ok actual outer lock is recognized without nested deadlock')
diff --git a/test/tools/glyph_bench_report.py b/test/tools/glyph_bench_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..284d53585242efc01851bba6d6ab544001df3e65
--- /dev/null
+++ b/test/tools/glyph_bench_report.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Require complete native glyph-benchmark samples and summarize their raw us."""
+import csv
+import json
+import math
+import sys
+from pathlib import Path
+
+
+def summarize(text):
+    expected = {name: 100 for name in (
+        "masks", "keys", "prekeyed", "table-guard", "convert-and-eq",
+        "key-eq", "extension-plan",
+    )}
+    expected.update({name: 1 for name in (
+        "font-open", "ascii-fill-table", "nonASCII-fill-table",
+        "fill-redraw-and-byte-check", "cold-frame",
+    )})
+    samples = {}
+    for row in csv.reader(text.splitlines()):
+        if not row or row[0] != "sample":
+            continue
+        if len(row) != 5 or row[1] not in expected:
+            raise ValueError(f"unexpected glyph sample: {row}")
+        _, name, index, elapsed, count = row
+        index, elapsed, count = int(index), int(elapsed), int(count)
+        if min(index, elapsed, count) < 0:
+            raise ValueError(f"negative glyph sample: {row}")
+        samples.setdefault(name, []).append((index, elapsed, count))
+    result = {}
+    for name, n in expected.items():
+        rows = samples.get(name, [])
+        if len(rows) != n or {row[0] for row in rows} != set(range(n)):
+            raise ValueError(f"{name}: expected {n} uniquely indexed samples; got {len(rows)}")
+        values = sorted(row[1] for row in rows)
+        result[name] = {"n": n, "p50_us": values[math.ceil(n * .50) - 1],
+                        "p99_us": values[math.ceil(n * .99) - 1], "max_us": values[-1]}
+    return {"scope": "Native glyph microbenchmark; whole-app targets require separate measurements.",
+            "samples": result}
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise SystemExit("usage: glyph_bench_report.py NATIVE_BENCH.log OUTPUT.json")
+    Path(sys.argv[2]).write_text(json.dumps(summarize(Path(sys.argv[1]).read_text()), indent=2) + "\n")
+    print("705 complete native glyph samples summarized")
