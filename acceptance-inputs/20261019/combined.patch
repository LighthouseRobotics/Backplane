+        z : U32 <- P.Perf.us()
+        IO.print("sample," ++ Nat.show(k) ++ "," ++ U32.show((b - a : U32)) ++ "," ++ U32.show((z - b : U32)) ++ "," ++ Nat.show(old) ++ "," ++ Nat.show(new))
+        sample(k, os, prev)
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    K.main()
+    +f : X.Face <- X.Text.face(["monospace"], 14)
+    +c : Map<&2, X.TG> <- X.Text.warm(Map.new(&2, X.TG), f)
