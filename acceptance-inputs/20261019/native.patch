diff --git a/test/tools/glyph_bench_report.py b/test/tools/glyph_bench_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..284d53585242efc01851bba6d6ab544001df3e65
--- /dev/null
+++ b/test/tools/glyph_bench_report.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Require complete native glyph-benchmark samples and summarize their raw us."""
+import csv
+import json
+import math
+import sys
+from pathlib import Path
+
+
+def summarize(text):
+    expected = {name: 100 for name in (
+        "masks", "keys", "prekeyed", "table-guard", "convert-and-eq",
+        "key-eq", "extension-plan",
+    )}
+    expected.update({name: 1 for name in (
+        "font-open", "ascii-fill-table", "nonASCII-fill-table",
+        "fill-redraw-and-byte-check", "cold-frame",
+    )})
+    samples = {}
+    for row in csv.reader(text.splitlines()):
+        if not row or row[0] != "sample":
+            continue
+        if len(row) != 5 or row[1] not in expected:
+            raise ValueError(f"unexpected glyph sample: {row}")
+        _, name, index, elapsed, count = row
+        index, elapsed, count = int(index), int(elapsed), int(count)
+        if min(index, elapsed, count) < 0:
+            raise ValueError(f"negative glyph sample: {row}")
+        samples.setdefault(name, []).append((index, elapsed, count))
+    result = {}
+    for name, n in expected.items():
+        rows = samples.get(name, [])
+        if len(rows) != n or {row[0] for row in rows} != set(range(n)):
+            raise ValueError(f"{name}: expected {n} uniquely indexed samples; got {len(rows)}")
+        values = sorted(row[1] for row in rows)
+        result[name] = {"n": n, "p50_us": values[math.ceil(n * .50) - 1],
+                        "p99_us": values[math.ceil(n * .99) - 1], "max_us": values[-1]}
+    return {"scope": "Native glyph microbenchmark; whole-app targets require separate measurements.",
+            "samples": result}
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise SystemExit("usage: glyph_bench_report.py NATIVE_BENCH.log OUTPUT.json")
+    Path(sys.argv[2]).write_text(json.dumps(summarize(Path(sys.argv[1]).read_text()), indent=2) + "\n")
+    print("705 complete native glyph samples summarized")
diff --git a/test/tools/native_display.ts b/test/tools/native_display.ts
new file mode 100644
index 0000000000000000000000000000000000000000..59cc51bd0f4a1e10386f1f40c76923488089ee84
--- /dev/null
+++ b/test/tools/native_display.ts
@@ -0,0 +1,62 @@
+// A demand comes from the driver before dispatch. An independent pixel
+// reader must observe the calibrated target region after dispatch.
+// This is X-server content acceptance, not compositor/physical scanout.
+export function displayPixels(bytes: Uint8Array, width: number, height: number, maskCaret = false): Uint8Array {
+  const header = new TextEncoder().encode(`P6\n${width} ${height}\n255\n`);
+  if (bytes.length !== header.length + width * height * 3 || !header.every((b, i) => bytes[i] === b)) {
+    throw new Error("native region readback is not the expected RGB PPM");
+  }
+  const pixels = bytes.slice(header.length);
+  if (maskCaret) {
+    // Only the solid caret colors in app/theme.bend are normalized. The
+    // calibrated ASCII composer probe has no colored text or selection.
+    const colors = new Map([[6271999, 1250843], [2060241, 15855852]]);
+    for (let i = 0; i < pixels.length; i += 3) {
+      const replacement = colors.get((pixels[i] << 16) | (pixels[i+1] << 8) | pixels[i+2]);
+      if (replacement !== undefined) pixels.set([replacement >> 16, (replacement >> 8) & 255, replacement & 255], i);
+    }
+  }
+  return pixels;
+}
+
+export async function awaitDisplay(
+  expected: string,
+  before: string,
+  read: () => Promise<string>,
+  now: () => number = () => performance.now(),
+  pause: (ms: number) => Promise<void> = ms => new Promise(r => setTimeout(r, ms)),
+  started = now(),
+  timeoutMs = 2000,
+): Promise<{ elapsed_ms: number; samples: number; pixel_sha256: string }> {
+  if (!expected || expected === before) throw new Error("display demand does not distinguish the target from the preceding content");
+  let samples = 0;
+  while (now() - started <= timeoutMs) {
+    const actual = await read();
+    samples++;
+    const elapsed = now() - started;
+    if (actual === expected && elapsed <= timeoutMs) return { elapsed_ms: elapsed, samples, pixel_sha256: actual };
+    await pause(4);
+  }
+  throw new Error("display demand timed out: expected content never reached the X-server region");
+}
+
+// Calibration is outside measured demand latency. A dispatched key is queued,
+// so two early reads can straddle its first frame. Require changed content (or
+// a known pristine empty target) to remain exactly stable for a bounded period.
+export async function calibrateDisplay(
+  read: () => Promise<string>,
+  options: { before?: string; expected?: string; stableMs?: number; timeoutMs?: number } = {},
+  now: () => number = () => performance.now(),
+  pause: (ms: number) => Promise<void> = ms => new Promise(r => setTimeout(r, ms)),
+): Promise<string> {
+  const started=now(),stableMs=options.stableMs ?? 300,timeoutMs=options.timeoutMs ?? 5000;
+  let value="",since=started,samples=0;
+  while(now()-started<=timeoutMs) {
+    const actual=await read(),at=now();
+    const allowed=actual && actual!==options.before && (!options.expected || actual===options.expected);
+    if(!allowed || actual!==value){value=allowed?actual:"";since=at;samples=0;}
+    if(allowed && value===actual && ++samples>=3 && at-since>=stableMs && at-started<=timeoutMs)return actual;
+    await pause(40);
+  }
+  throw new Error("calibration timed out: changed/expected pixels never became stable");
+}
