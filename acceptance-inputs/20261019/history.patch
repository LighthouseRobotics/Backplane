index 0000000000000000000000000000000000000000..52400b87f9f8fa61a241f24b9e8dac1e0234f2e3
--- /dev/null
+++ b/test/tools/history_render.bend
@@ -0,0 +1,51 @@
+import Base
+import ../../src/core/client.bend as U
+import ../../src/core/model.bend as M
+import ../../src/core/hist.bend as H
+import ../../src/core/i18n.bend as I
+import ../../src/core/json.bend as J
+import ../../src/web/view.bend as W
+import ../../src/web/dom.bend as D
+import ../../src/mobile/view.bend as P
+
+# Generated history, never a real event store. Include board and schematic
+# edits and user text before each step, as a long CAD conversation does.
+def changes(+n: Nat, acc: List<&2, M.Change>) -> List<&2, M.Change>:
+  match n:
+    case 0n:
+      acc
+    case 1n+k:
+      +id = Nat.show(1n+k)
+      changes(k,
+        M.MessagePosted{"t", "u" ++ id, M.User{}, "Route stage " ++ id ++ " 日本語", 1n+k} <>
+        M.ActivityLogged{"t", "step:c" ++ id, "step", "kicad",
+          H.Hist.record("c" ++ id ++ "\nc" ++ Nat.show(k) ++ "\n/r/.git\n/r\nM\0b.kicad_pcb\0M\0s.kicad_sch\0", "u" ++ id), 1n+k} <> acc)
+
+def ui(a: U.Act) -> U.Ui:
+  match a:
+    case U.Act{u, _}: u
+
+def make(n: Nat) -> U.Ui:
+  U.Ui.view_put(ui(U.Ui.act(U.Ui.adopt(U.Ui.init(0n), M.State.replay(
+    M.ThreadCreated{"t", "", "Synthetic CAD history", M.Local{}, "", "", "claude", "", 0n} <> changes(n, Nil{}), M.State.empty())), "select", "t")), "board", "/r/b.kicad_pcb")
+
+def variant(+u: U.Ui, +v: String) -> U.Ui:
+  match v:
+    case "schematic":
+      U.Ui.view_put(u, "schematic", "/r/s.kicad_sch")
+    case "compare":
+      ui(U.Ui.act(ui(U.Ui.act(u, "cmp", "")), "cmp-pick", "a\tc1\tStep 1\t/r/.git\t/r"))
+    case _:
+      ui(U.Ui.act(u, v, ""))
+
+def bar(+u: U.Ui, +l: I.Loc) -> U.HBar:
+  U.Hs.bar.loc(l, u)
+
+def web(+u: U.Ui, +l: I.Loc) -> List<&2, D.Node>:
+  W.View.hist.of(l, U.Hs.track(u), u)
+
+def webmenu(+u: U.Ui, +l: I.Loc) -> D.Node:
+  W.View.hist.menu(l, U.Hs.track(u), u)
+
+def phone(+u: U.Ui, +l: I.Loc) -> String:
+  J.Json.show(P.Hist.json(l, True{}, u))
diff --git a/test/tools/history_render.mjs b/test/tools/history_render.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d5a0e8091e05b2b6fe3897c8b781bf72ab9f5c1a
--- /dev/null
+++ b/test/tools/history_render.mjs
@@ -0,0 +1,54 @@
+// bend test/tools/history_render.bend -o build/history-render.mjs
+// node test/tools/history_render.mjs build/history-render.mjs [baseline.json]
+import { pathToFileURL } from "node:url";
+import { resolve } from "node:path";
+import { readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import assert from "node:assert/strict";
+const { default: B } = await import(pathToFileURL(resolve(process.argv[2])));
+const baseline = process.argv[3] && JSON.parse(readFileSync(process.argv[3], "utf8"));
+const encode = v => JSON.stringify(v, (_, x) => typeof x === "bigint" ? x.toString() : x);
+// Iterative traversal: a long list of ticks must not overflow the test
+// runner's JSON serializer stack. Preserve all keys, text and leaf values.
+const hash = x => {
+  const h = createHash("sha256"), todo = [x];
+  while (todo.length) {
+    const v = todo.pop();
+    if (v && typeof v === "object") {
+      const keys = Object.keys(v);
+      h.update(Array.isArray(v) ? "array" : "object");
+      h.update(JSON.stringify(keys));
+      for (let i = keys.length - 1; i >= 0; i--) todo.push(v[keys[i]]);
+    } else {
+      const leaf = encode(v) ?? "undefined";
+      h.update(`${typeof v}:${leaf.length}:${leaf}`);
+    }
+  }
+  return h.digest("hex");
+};
+const results = [];
+const samples = [];
+for (const n of [0, 3, 64, 256, 1024]) {
+  const u = B.make(BigInt(n));
+  assert.equal(B.bar(u, {$: "En"}).n, BigInt(n), `fixture track ${n}`);
+  for (const language of ["En", "Ja"]) {
+    const l = {$: language};
+    for (const variant of ["live", "hist-first", "hist-last", "hist-diff", "hist-play", "compare", "schematic", "panel"]) {
+      const state = variant === "live" ? u : B.variant(u, variant);
+      for (const client of ["bar", "web", "phone", "webmenu"]) {
+        const value = B[client](state, l);
+        const id = `${n}/${language}/${variant}/${client}`;
+        const digest = hash(value);
+        if (baseline) assert.equal(digest, baseline.results.find(x=>x.id===id)?.sha256, id);
+        results.push({id, sha256:digest});
+      }
+    }
+    for (const client of ["bar", "web", "phone"]) {
+      const times=[];
+      for(let i=0;i<7;i++) {const t=performance.now(); B[client](u,l); times.push(performance.now()-t);}
+      times.sort((a,b)=>a-b);
+      samples.push({steps:n, language, client, medianMs:times[3],p95Ms:times[6]});
+    }
+  }
+}
+console.log(JSON.stringify({runtime:process.version,results,samples,baselineCompared:!!baseline},null,2));
