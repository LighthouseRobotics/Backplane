index 0000000000000000000000000000000000000000..22dd655b3a59bb45889fbcf7c16d9cb470a5b818
--- /dev/null
+++ b/test/tools/ios_profile_state.ts
@@ -0,0 +1,45 @@
+// Build current-type kept state from persisted events; no sockets/providers.
+import { readFileSync, writeFileSync } from 'node:fs';
+const [bridge, events, out] = process.argv.slice(2);
+if (!bridge || !events || !out) throw Error('BRIDGE EVENTS OUT');
+(0, eval)(readFileSync(bridge, 'utf8'));
+const B = (globalThis as any).Backplane;
+const utf = new TextEncoder();
+function encode(v: any, a: number[]) {
+  const head = (m: number, n: number) => {
+    if (n < 24) a.push(m | n);
+    else if (n < 256) a.push(m | 24, n);
+    else if (n < 65536) a.push(m | 25, n >> 8, n & 255);
+    else a.push(m | 26, (n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255);
+  };
+  if (v === null) { a.push(246); return; }
+  if (typeof v === 'boolean') { a.push(v ? 245 : 244); return; }
+  if (typeof v === 'number') {
+    if (Number.isInteger(v) && v >= 0 && v < 2 ** 32) head(0, v);
+    else { a.push(199); encode(String(v), a); }
+    return;
+  }
+  if (typeof v === 'string') { const bytes = utf.encode(v); head(96, bytes.length); for (const b of bytes) a.push(b); return; }
+  if (Array.isArray(v)) { head(128, v.length); for (const x of v) encode(x, a); return; }
+  const entries = Object.entries(v); head(160, entries.length);
+  for (const [k, x] of entries) { encode(k, a); encode(x, a); }
+}
+B.start('ios-profile', '{}');
+const key = 'fixture:3897'; B.hubs([key]);
+const lines = readFileSync(events, 'utf8').split('\n').filter(Boolean);
+let count = 0;
+for (let i = 0; i < lines.length; i += 512) {
+  const items = lines.slice(i, i + 512).map(l => JSON.parse(l));
+  const a: number[] = []; const more = i + 512 < lines.length;
+  encode({t: i === 0 ? 'log' : 'changes', items, more, boot: more,
+    info: {machines: JSON.stringify({self:{name:'Profile machine'}})}}, a);
+  B.recv(key, Buffer.from(a).toString('base64'), true);
+  count += items.length;
+  if (i % 8192 === 0) console.log('folded', count);
+}
+const text = B.screen();
+const s = JSON.parse(text).screen;
+if (!s?.uber && !(s?.bots ?? []).some((b:any) => /Bub/.test(b.name))) throw Error('no Bub/Uberbot after replay');
+writeFileSync(out, B.save());
+writeFileSync(out + '.screen.json', text);
+console.log('PASS', count, 'events; current state saved; hubs',s.hubs.length,'bots',s.bots.length,'uber',!!s.uber);
diff --git a/test/tools/ios_recent_bridge_test.ts b/test/tools/ios_recent_bridge_test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3bd90561aba3bfc11d5a563016bf415e95aba7c8
--- /dev/null
+++ b/test/tools/ios_recent_bridge_test.ts
@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import vm from 'node:vm';
+import {encode} from './ios_test_cbor';
+import {cbor,plain} from '../../src/web/wire.js';
+const [bridge,fixture]=process.argv.slice(2);
+const b:any={console};vm.runInNewContext(readFileSync(bridge,'utf8'),b);
+const f:any={console};vm.runInNewContext(readFileSync(fixture,'utf8'),f);
+const B=b.Backplane, server=f.RecentFixture;
+const metadata=JSON.parse(B.headerKeys());
+const un=(cmd:any)=>plain(cbor(new Uint8Array(Buffer.from(cmd.data,'base64')),metadata.keys,metadata.words));
+const receive=(value:any)=>{const a:number[]=[];encode(value,a);return JSON.parse(B.recv('box:3787',Buffer.from(a).toString('base64'),false,false));};
+const screenRequest=(out:any)=>out.cmds.map((c:any)=>c.type==='send'?un(c):null).find((r:any)=>r?.m==='mobile.screen');
+const answer=(r:any)=>receive({t:'reply',id:r.id,ok:true,result:JSON.parse(server.render(JSON.stringify(r.p)))});
+B.start('phone','{}');B.hubs(['box:3787']);B.online('box:3787',true,true);
+let out=receive({t:'mobile',generation:'g1'});
+assert.equal(out.screen,null);
+assert.equal(out.sync[0].phase,'recent');
+const initial=screenRequest(out);assert.ok(initial);
+out=answer(initial);
+assert.ok(out.screen.projects.length,'authoritative recent presentation before any log replay');
+assert.equal(out.cmds.map((c:any)=>c.type==='send'?un(c)?.m:'').filter((m:any)=>m==='mobile.history').length,1);
+assert.equal(JSON.parse(B.resume('box:3787')).since,'0','presentation never advances canonical cursor');
+out=answer(screenRequest(JSON.parse(B.act('select','box:3787|t2'))));
+assert.equal(out.screen.thread.id,'box:3787|t2');
+assert.equal(out.screen.thread.readingSeen,'raw-message','reading holds the raw event ID, not a rendered paragraph/fold ID');
+assert.deepEqual(Array.from(out.screen.thread.permissions.choices,(c:any)=>c.value),['approval-required','auto-accept-edits','auto','full-access'],'authoritative server preview preserves exact permission protocol values');
+out=answer(screenRequest(JSON.parse(B.act('select','box:3787|t3'))));
+B.quiet('draft','keep thread three');
+out=answer(screenRequest(JSON.parse(B.act('select','box:3787|t2'))));
+B.quiet('draft','old thread two');
+const delayedSelection=screenRequest(JSON.parse(B.act('select','box:3787|t3')));
+B.quiet('draft','latest thread two');
+out=answer(delayedSelection);
+assert.equal(out.screen.thread.id,'box:3787|t3');
+assert.equal(out.screen.thread.draft,'keep thread three','delayed selection cannot move an edit onto the destination');
+assert.equal(out.cmds.filter((c:any)=>c.type==='keep').at(-1).thread,'box:3787|t2','draft persistence keeps original thread identity');
+out=answer(screenRequest(JSON.parse(B.act('select','box:3787|t2'))));
+assert.equal(out.screen.thread.draft,'latest thread two','returning to original thread recovers its newer draft');
+const changingBeforePermission=screenRequest(JSON.parse(B.act('select','box:3787|t3')));
+assert.equal(screenRequest(JSON.parse(B.act('thread-permissions','auto-accept-edits'))),undefined,'permission waits for the pending selection');
+out=answer(changingBeforePermission);
+const queuedPermission=screenRequest(out);
+out=answer(queuedPermission);
+const queuedMode=out.cmds.filter((c:any)=>c.type==='send').map(un).find((r:any)=>r.m==='thread.modes');
+assert.equal(queuedMode.p.thread,'t2','queued permission applies to the thread visible at tap');
+assert.equal(answer(queuedPermission).cmds.filter((c:any)=>c.type==='send').map(un).filter((r:any)=>r.m==='thread.modes').length,0,'duplicate queued permission reply cannot issue twice');
+const permission = screenRequest(JSON.parse(B.act('thread-permissions','auto-accept-edits')));
+assert.ok(permission, 'permission tap requests an authoritative recent action');
+const permissionOut = answer(permission);
+const permissionRPC = permissionOut.cmds.filter((c:any)=>c.type==='send').map(un).find((r:any)=>r.m==='thread.modes');
+assert.ok(permissionRPC, 'recent permission action emits the ordinary mutation RPC');
+assert.equal(permissionRPC.p.thread,'t2');
+assert.equal(permissionRPC.p.runtime,'auto-accept-edits');
+B.quiet('draft','captured message');
+const send=screenRequest(JSON.parse(B.act('send','')));assert.ok(send);
+B.quiet('draft','new unsent draft');
+out=answer(send);
+const sends=out.cmds.filter((c:any)=>c.type==='send').map(un).filter((o:any)=>o.m==='turn.start');
+assert.equal(sends.length,1);
+assert.equal(sends[0].p.text,'captured message');
+assert.equal(out.cmds.filter((c:any)=>c.type==='keep').at(-1).text,'new unsent draft','old clear cannot overwrite a newer saved draft');
+const refresh=screenRequest(receive({t:'reply',id:sends[0].id,ok:true}));
+assert.ok(refresh,'durable mutation acknowledgement refreshes the authoritative recent screen');
+assert.equal(answer(send).cmds.filter((c:any)=>c.type==='send').map(un).filter((o:any)=>o.m==='turn.start').length,0,'duplicate presentation reply never sends twice');
+const pendingMode=screenRequest(JSON.parse(B.act('thread-permissions','approval-required')));
+assert.ok(pendingMode,'permission action preempts outstanding refresh');
+out=receive({t:'log',origin:'canonical-origin',more:true,info:{},items:[{$:'ProjectCreated',id:'p2',title:'Box',root:'/box',at:50}]});
+assert.equal(out.screen,null,'old history never replaces recent presentation');
