--- /dev/null
+++ b/test/tools/ios_bridge_profile.swift
@@ -0,0 +1,35 @@
+import Foundation
+import JavaScriptCore
+
+// Run against a copied kept state, never a live hub. App actions are
+// evaluated but their send commands are retained as evidence, not executed.
+setbuf(stdout, nil)
+let args = CommandLine.arguments
+precondition(args.count == 3, "BRIDGE STATE")
+let c = JSContext()!
+c.exceptionHandler = { _, e in fputs("JSC ERROR \(e?.toString() ?? "")\n", stderr) }
+c.evaluateScript(try String(contentsOfFile: args[1], encoding: .utf8))
+let b = c.objectForKeyedSubscript("Backplane")!
+var screen: [String: Any] = [:]
+@discardableResult func call(_ name: String, _ args: [Any]) -> [String: Any] {
+    let t = DispatchTime.now().uptimeNanoseconds
+    let text = b.invokeMethod(name, withArguments: args)?.toString() ?? ""
+    let j = (try? JSONSerialization.jsonObject(with: Data(text.utf8))) as? [String: Any] ?? [:]
+    if let s = j["screen"] as? [String: Any] { screen = s }
+    print("PROFILE \(name) ms=\(Double(DispatchTime.now().uptimeNanoseconds-t)/1e6) bytes=\(text.utf8.count) entries=\((screen["thread"] as? [String: Any])?["entries"] as? [Any] != nil ? ((screen["thread"] as! [String: Any])["entries"] as! [Any]).count : 0)")
+    return j
+}
+call("start", ["ios-profile", "{}"])
+call("load", [try String(contentsOfFile: args[2], encoding: .utf8)])
+let uber = screen["uber"] as? [String: Any]
+let bot = ((screen["bots"] as? [[String: Any]]) ?? []).first { ($0["name"] as? String ?? "").contains("Bub") }
+guard let row = uber ?? bot, let id = row["id"] as? String else { fatalError("no Bub/Uberbot fixture") }
+let action = uber == nil ? (row["act"] as? String ?? "bot") : "uber"
+for _ in 0..<3 {
+    call("act", ["select", ""])
+    call("act", [action, id])
+    call("screen", [])
+    call("quiet", ["draft", "ios copied-state delivery probe"])
+    let out = call("act", ["send", ""])
+    print("PROFILE send commands=\((out["cmds"] as? [Any])?.count ?? 0)")
+}
diff --git a/test/tools/ios_connection_observation_test.swift b/test/tools/ios_connection_observation_test.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cba9b822a36bf594424ea214885247ba790c6752
--- /dev/null
+++ b/test/tools/ios_connection_observation_test.swift
@@ -0,0 +1,39 @@
+import Foundation
+import Observation
+
+private final class Count: @unchecked Sendable {
+    private let lock = NSLock()
+    private var n = 0
+    func increment() { lock.withLock { n += 1 } }
+    var value: Int { lock.withLock { n } }
+}
+
+// Uses the actual connection store, without a hub, native renderer or mocks.
+@main private struct Test {
+    @MainActor static func main() {
+        let c = HubConnections()
+        let key = "one:3787"
+        c[key, default: HubConn()].phase = .syncing
+        c[key, default: HubConn()].epoch = 7
+        let statusChanges = Count()
+        withObservationTracking { _ = c[key]?.phase; _ = c[key]?.stage } onChange: { statusChanges.increment() }
+        for n in 0..<1000 { c.received(key, bytes: 64, at: Date(timeIntervalSince1970: Double(n))) }
+        precondition(statusChanges.value == 0, "stream traffic invalidated status-dependent UI")
+        precondition(c.traffic(key).bytes == 64000)
+        precondition(c.traffic(key).heard == Date(timeIntervalSince1970: 999))
+        precondition(c[key]?.epoch == 7)
+        c[key, default: HubConn()].phase = .online
+        precondition(statusChanges.value == 1, "online transition must update controls immediately")
+        let heardChanges = Count()
+        withObservationTracking { _ = c.traffic(key).heard } onChange: { heardChanges.increment() }
+        c.received(key, bytes: 128, at: Date(timeIntervalSince1970: 1000))
+        precondition(heardChanges.value == 1, "hub details must retain traffic observation")
+        precondition(c.traffic(key).bytes == 64000, "catch-up count only grows while catching up")
+        let disconnects = Count()
+        withObservationTracking { _ = c[key]?.phase } onChange: { disconnects.increment() }
+        c[key, default: HubConn()].phase = .offline
+        precondition(disconnects.value == 1, "offline status must update immediately")
+        precondition(c.traffic("two:3787").heard == nil)
+        print("PASS 1000 off-screen frames do not invalidate connection-status UI; traffic, epoch and online/offline remain exact")
+    }
+}
